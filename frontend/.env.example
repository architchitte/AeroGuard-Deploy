# =================================================================
# AeroGuard Frontend - Environment Configuration Example
# Copy this file to .env.local for local overrides, or set the
# variable in your hosting provider (e.g. Vercel → Project Settings → Environment Variables).
# =================================================================

# Base URL of the AeroGuard FastAPI backend (no trailing slash).
# If unset: localhost uses http://localhost:8000, everything else uses
# https://aeroguard-deploy.onrender.com
VITE_API_BASE_URL=https://aeroguard-deploy.onrender.com
